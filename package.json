{
  "name": "kanjiforge",
  "version": "0.1.0",
  "description": "A free, offline-first web app for studying kanji with the StickyStudy SRS system.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:decks": "tsx scripts/build-packs/build-decks.ts",
    "build:kanji": "tsx scripts/build-packs/build-kanji-pack.ts",
    "build:sentences-pack": "npx --yes tsx scripts/build-packs/build-sentences-pack.ts",
    "build:similar": "tsx scripts/build-packs/build-similar-pack.ts",
    "build:strokes-pack": "npx tsx scripts/build-packs/build-strokes-pack.ts",
    "build:words-core": "tsx scripts/build-packs/build-words-core-pack.ts",
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run test:coverage && npm run test:e2e && npm run packs:verify && npm run packs:test",
    "dev": "next dev",
    "fetch:sources": "tsx scripts/build-packs/fetch-sources.ts",
    "format:check": "prettier --check .",
    "lint": "npm run format:check; eslint src --max-warnings 0; npm run typecheck:worker",
    "typecheck:worker": "tsc --project tsconfig.worker.json",
    "packs:full": "node scripts/build-packs/pipeline.mjs --mode full",
    "packs:refresh": "pnpm fetch:sources -- --refresh && pnpm build:kanji && pnpm build:words-core && pnpm build:strokes-pack && pnpm build:sentences-pack && pnpm build:similar && pnpm build:decks && pnpm packs:full",
    "packs:repro": "node scripts/build-packs/reproducibility.mjs",
    "packs:test": "vitest run scripts/build-packs/pipeline.test.mjs scripts/build-packs/fetch-sources.test.ts",
    "packs:verify": "node scripts/build-packs/pipeline.mjs --mode ci",
    "postinstall": "node scripts/copy-sql-wasm.mjs && node scripts/copy-dev-packs.mjs",
    "prebuild": "node scripts/copy-sql-wasm.mjs && node scripts/copy-dev-packs.mjs",
    "predev": "node scripts/copy-sql-wasm.mjs && node scripts/copy-dev-packs.mjs",
    "prettify": "prettier --write .",
    "start": "next start",
    "test:decks": "vitest run --project unit-node-decks",
    "test:watch": "vitest --watch",
    "test": "vitest run --project unit-dom --project unit-node",
    "test:coverage": "vitest run --coverage --project unit-dom --project unit-node",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-primitive": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serwist": "^9.5.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@next/env": "15.5.21",
    "@playwright/test": "^1.61.1",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^13.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.1.3",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.48",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "serve": "^14.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
