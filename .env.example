# Runtime server configuration. These are only needed for authenticated routes,
# database migrations, and optional server-backed sync/push.
DATABASE_URL=postgresql://kanjiforge:<password>@localhost:5432/kanjiforge
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Optional live sync and Web Push configuration.
ELECTRIC_URL=
ELECTRIC_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
PUSH_CRON_SECRET=

# Public (client-visible) environment variables. Never put secrets here.
# Leave NEXT_PUBLIC_API_URL empty for the recommended same-origin deployment.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ELECTRIC_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
