# Public (client-visible) environment variables. See src/server/env.ts for the
# full server-side configuration contract (DATABASE_URL, BETTER_AUTH_*, etc.).

# Origin of the self-hosted auth/API backend. Leave unset to run the client
# fully offline against a cached session; auth- and sync-dependent e2e specs
# skip automatically when this is unset.
NEXT_PUBLIC_API_URL=

# Public origin this app is deployed at, used for the sitemap, robots.txt,
# and canonical/Open Graph URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
