{
  "name": "KanjiForge — Japanese kanji study",
  "short_name": "KanjiForge",
  "start_url": "/home?source=pwa",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e8e4dc",
  "theme_color": "#e8e4dc",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Study",
      "short_name": "Study",
      "url": "/study"
    },
    {
      "name": "Dictionary",
      "short_name": "Dictionary",
      "url": "/dictionary"
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "text": "text",
      "title": "title",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/json": [".kanjiforge", ".json"]
      }
    }
  ]
}
