# Copy to deploy/.env and replace every placeholder. Do not commit deploy/.env.
POSTGRES_DB=kanjiforge
POSTGRES_USER=kanjiforge
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-32-character-or-longer-random-secret
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Required by Electric 1.7.8. Generate separately: openssl rand -base64 48
ELECTRIC_SECRET=replace-with-a-long-random-electric-secret

# Web Push: generate a matching pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
# Keep this secret for the scheduler that calls POST /api/push/reminders.
PUSH_CRON_SECRET=replace-with-a-long-random-push-cron-secret
# URL reachable by the optional compose push-cron service.
KANJIFORGE_APP_URL=http://host.docker.internal:3000
